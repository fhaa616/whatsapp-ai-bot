# Dependencies
node_modules/

# Environment variables (simpan rahasia di sini, jangan di-commit)
.env
.env.*
!.env.example

# WhatsApp session & cache
session/
.wwebjs_auth/
.wwebjs_cache/

# File sementara konversi dokumen (folder tetap ada lewat .gitkeep)
temp/*
!temp/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Cache & tooling
.cache/
.npm
.eslintcache
.node_repl_history
*.tgz

# Package manager
.pnpm-store/
.yarn-integrity
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db